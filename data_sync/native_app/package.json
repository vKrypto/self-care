{
  "name": "forma-data-sync",
  "version": "0.3.8",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "build:apk": "cd android && ./gradlew assemblePreview && cd .. && node scripts/export-apks.mjs preview",
    "build:apk:lan": "cd android && ./gradlew assembleLan && cd .. && node scripts/export-apks.mjs lan",
    "export:apk": "node scripts/export-apks.mjs preview",
    "export:apk:lan": "node scripts/export-apks.mjs lan",
    "android:preview": "react-native run-android --mode preview --no-packager",
    "android:lan": "react-native run-android --mode lan --no-packager",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/build/generated/verification/index.android.bundle --assets-dest android/app/build/generated/verification/assets"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
