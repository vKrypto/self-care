# Backend only. Never use a VITE_ prefix for secrets.
OPEN_API_KEY=openapi_key_example
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai
# Leave blank to use the persistent tenant-scoped file cache.
REDIS_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Optional email delivery. In-app notifications work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=forma@localhost
